# Copy to .env and fill in. .env is gitignored — never commit real tokens.
# Use your own Anthropic key, and the tokens from your own MCP server and
# audience board deployments.

ANTHROPIC_API_KEY=
MCP_AUTH_TOKEN=

# Defaults to the local fake (uvicorn fake_mcp.server:app --port 8931).
# Point it at a deployed temporal-agntcon-mcp server to run for real:
# MCP_ENDPOINT=https://<your-mcp-server>/mcp

# Audience board, for switch state on the stage screen.
# BOARD_URL is an https ORIGIN — the stage screen polls {BOARD_URL}/api/admin/state.
# Not a websocket URL: we poll, we don't subscribe.
# BOARD_URL=https://<your-audience-board>
# BOARD_ADMIN_TOKEN=

# Once set, placing and stopping orders need it, and POST /api/orders/terminate
# (which ends every running order) is enabled. Open the stage screen once as
# /?token=<value>. Unset: orders are open and terminate is disabled, which is
# the right default for local work.
# STAGE_ADMIN_TOKEN=

# Local Temporal by default
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default

# AGENT_MODEL=claude-opus-5
# AGENT_THINKING=on
