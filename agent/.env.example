# Copy to .env and fill in. .env is gitignored — never commit real tokens.
# Current values live in iandouglas/temporal-agntcon-devnotes/notes-for-melissa.md
# Both tokens are rotated after the talk.

ANTHROPIC_API_KEY=
MCP_AUTH_TOKEN=

# Ian's deployed MCP server (the default). Use the local fake instead with:
#   MCP_ENDPOINT=http://localhost:8931/mcp
# MCP_ENDPOINT=https://mcp-production-00c3d.up.railway.app/mcp

# Audience board, for switch state on the stage screen.
# BOARD_URL is an https ORIGIN — the stage screen polls {BOARD_URL}/api/admin/state.
# Not a websocket URL: we poll, we don't subscribe.
# BOARD_URL=https://audience-site-production.up.railway.app
# BOARD_ADMIN_TOKEN=

# Guards POST /api/orders/terminate, which ends every running order. Unset
# means that endpoint is disabled, which is the right default for local work.
# STAGE_ADMIN_TOKEN=

# Local Temporal by default
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default

# AGENT_MODEL=claude-opus-5
# AGENT_THINKING=on
